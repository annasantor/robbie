      </inertial>                 
    </link>  
     
    <joint name="shoulder_pitch" type="revolute">
      <parent link="link_0"/>
      <child link="link_1"/>
      <origin xyz="0.03 0.0725 0.083" rpy="0 -1.5806 0"/>
      <axis xyz="0 0 1"/>  <!-- Rotate around z-axis at this point -->
      <limit lower="-1.570795" upper="1.570795" velocity="26" effort="3.0"/>
      <dynamics damping="0.5" friction="0.1"/>  <!-- ← add this -->
    </joint>
   
    <link name="link_2">
      <visual>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0375" length="0.036"/>
        </geometry>
        <material name="black"/>
      </visual>      
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
