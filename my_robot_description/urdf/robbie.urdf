<?xml version="1.0"?>
<robot name="robbie">
    <material name="blue">
      <color rgba="0 0 0.8 1"/>
    </material>
    <material name="black">
      <color rgba="0 0 0 1"/>
    </material>
    <material name="white">
      <color rgba="1 1 1 1"/>
    </material>    
    <material name="grey">
      <color rgba ="0 0 0 0.5"/>
    </material>
    <material name="yellow">
      <color rgba ="1 1 0 0.5"/> 
    </material>    

    <link name="world"/>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.07 0.20 0.405"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <visual>
        <origin xyz="0 0.07 0.2025" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.1 0.01"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.07 0.20 0.405"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <box size="0.10 0.05 0.01"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="world_to_base" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint> 

    <link name="link_0">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0375" length="0.036"/>
        </geometry>
        <material name="black"/>
      </visual>
      <visual>
        <origin xyz="0 0.0 0.043" rpy="0 0 0"/>
        <geometry>
          <box size="0.115 0.075 0.085"/>
        </geometry>
        <material name="grey"/>
      </visual>      
      <collision>
        <geometry>
          <cylinder radius="0.0375" length="0.036"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <box size="0.115 0.075 0.055"/>
        </geometry>    
      </collision>
      <inertial>
        <mass value="1"/>
        <inertia ixx="0.00064294375" ixy="0" ixz="0" iyy="0.00083294375" iyz="0" izz="0.0009634374999999999"/>
      </inertial>
    </link>       

    <joint name="shoulder_roll" type="revolute">
      <parent link="base_link"/>
      <child link="link_0"/>
      <origin xyz="0 0.09 0.22" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>  <!-- Rotate around z-axis at this point -->
      <limit lower="-1.570795" upper="1.570795" velocity="26" effort="3.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
 
    <link name="link_1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.03"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <visual>
        <origin xyz="0 +0.006 +0.0675" rpy="0 0 1.5806"/>
        <geometry>
          <box size="0.08 0.023 0.105"/>
        </geometry>
        <material name="grey"/>
      </visual>      
      <collision>
        <geometry>
          <cylinder radius="0.02" length="0.03"/>
        </geometry>
      </collision>       
      <collision>
        <geometry>
          <box size="0.08 0.023 0.105"/>
        </geometry>
      </collision> 
      <inertial>
