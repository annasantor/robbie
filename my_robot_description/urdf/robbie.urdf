      </inertial>                 
    </link>  
    
    <joint name="elbow_roll" type="revolute">
      <parent link="link_1"/>
      <child link="link_2"/>
      <origin xyz="-0.08 0.01 0.05" rpy="0 1.5806 0"/>
      <axis xyz="0 0 1"/>  <!-- Rotate around z-axis at this point -->
      <limit lower="-1.570795" upper="1.570795" velocity="60" effort="2.0"/>
      <dynamics damping="0.5" friction="0.1"/>  <!-- ← add this -->
    </joint>   
  
    <link name="link_3">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0157" length="0.022"/>
